{
  "name": "nce-reading",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "新概念英语在线点读系统 — Vue3 + Vite + TypeScript + TailwindCSS 4",
  "scripts": {
    "generate:books": "node scripts/generate-book-json.cjs",
